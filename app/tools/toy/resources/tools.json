      "description": "设置三个通道的完整强度。待发自由强度由最新值覆盖，使用既有连接，持续生效直到下一条强度或停止命令；不会自动停止。物理功能名称待用户确认。",
      "parameters": {
        "type": "object",
        "properties": {
          "channel1": {
            "type": "integer",
            "anyOf": [
              {
                "enum": [
                  0
                ]
              },
              {
                "minimum": 15,
                "maximum": 100
              }
            ],
            "description": "0关闭该通道；15–100为源码UI强度。不是0–255原始字节。"
          },
          "channel2": {
            "type": "integer",
            "anyOf": [
              {
                "enum": [
                  0
                ]
              },
              {
                "minimum": 15,
                "maximum": 100
              }
            ],
            "description": "0关闭该通道；15–100为源码UI强度。不是0–255原始字节。"
          },
          "channel3": {
            "type": "integer",
            "anyOf": [
              {
                "enum": [
                  0
                ]
              },
              {
                "minimum": 15,
                "maximum": 100
              }
            ],
            "description": "0关闭该通道；15–100为源码UI强度。不是0–255原始字节。"
          }
        },
        "required": [
          "channel1",
          "channel2",
          "channel3"
        ],
        "additionalProperties": false
      }
    }
  },
